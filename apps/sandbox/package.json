{
  "name": "@shulker/sandbox",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "main": "dist/server.js",
  "scripts": {
    "dev": "node --watch src/server.ts",
    "start": "node dist/server.js",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "build": "tsc -p tsconfig.json",
    "test": "node --test --test-reporter=spec --experimental-strip-types --no-warnings --env-file-if-exists=../../.env src/smoke.test.ts"
  },
  "dependencies": {
    "@shulker/shared": "*"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "typescript": "^5.6.0"
  }
}
