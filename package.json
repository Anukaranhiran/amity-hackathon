{
  "name": "shulker",
  "private": true,
  "version": "1.0.0",
  "description": "Shulker — AI-assisted zero-trust API vulnerability scanner",
  "type": "module",
  "workspaces": [
    "packages/shared",
    "packages/scanner-core",
    "apps/sandbox",
    "apps/scan-api",
    "apps/cli",
    "apps/web"
  ],
  "scripts": {
    "build": "npm run build --workspaces --if-present",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "test": "npm run test --workspaces --if-present",
    "test:e2e": "node scripts/e2e.mjs",
    "dev": "bash scripts/dev.sh",
    "dev:api": "bash scripts/dev.sh --no-web"
  },
  "engines": {
    "node": ">=20.10"
  }
}
