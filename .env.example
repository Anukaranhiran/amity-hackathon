# SentinelAPI scanner backend configuration
# Copy to .env and fill in. NEVER expose this key to frontend code.

# Google Gemini API key (AI reasoning layer). Optional: the scanner
# falls back to deterministic reasoning when absent or unreachable.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.0-flash

# Scanner backend port (default 8600)
PORT=8600

# SentinelLab sandbox port (default 8700)
SANDBOX_PORT=8700
SANDBOX_JWT_SECRET=sentinellab-demo-secret
