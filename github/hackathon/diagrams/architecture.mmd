%% Shulker — High-Level Architecture
flowchart TB
    subgraph Browser["🖥️ Dashboard — apps/web (React 18 + Vite :5173)"]
        UI["14 pages: Overview · NewScan wizard · Findings · Evidence · Reports · Inventory · Attack Surface · Coverage · Resource Graph · Activity · Settings"]
        TPL["templates.ts — one-click OpenAPI 3.0.3 generators (Gemini / OpenAI / GitHub / Stripe)"]
        APICLIENT["api.ts — typed REST client + native EventSource (SSE)"]
    end

    subgraph Backend["⚙️ Scanner Backend — apps/scan-api (Node 20, zero deps :8600)"]
        ROUTES["server.ts — REST routes · validateTarget() consent gate · buildAuthHeaders()"]
        SSE["SSE hub — /api/scan-events/:id"]
        DB[("db.ts — node:sqlite shulker.db (scans, findings, evidence, inventory, settings)")]
        DISC["discovery.ts — OpenAPI/Postman/HAR/manual import + validateSourceUrl()"]
        REP["reports.ts — HTML / Markdown / JSON (redacted)"]
    end

    subgraph Engine["🔎 Scan Engine — packages/scanner-core"]
        ENG["engine.ts — ScanEngine: 7-phase lifecycle, budget meter, watchdog, cancel"]
        PARSER["parser.ts — OpenAPI 3 / Swagger 2 / Postman / HAR → ApiSpecModel"]
        RES["resources.ts — actor + resource-ownership model"]
        AI["ai.ts — Gemini hypotheses (advisory only)"]
        DET["detectors: bola · bfla · exposure · ratelimit (OWASP API1/5/3/4)"]
        HTTP["SafeHttpClient — the ONLY network egress: scope check, header hygiene, timeouts, budget"]
        EVID["evidence.ts — capture → redact → attach"]
    end

    subgraph Shared["📦 packages/shared (zero deps)"]
        TYPES["types.ts — ScanConfig / ScanResult / Finding"]
        RED["redact.ts + sensitive.ts — token redaction engine"]
        SEV["severity.ts — ordering & roll-up"]
    end

    subgraph Targets["🎯 Targets"]
        LAB["apps/sandbox — ShulkerLab (deliberately vulnerable, loopback :8700)"]
        EXT["External authorized HTTPS APIs (two-gate consent)"]
    end

    CLI["⌨️ apps/cli — shulker scan --target --openapi --api-key --fail-on (CI gate)"]

    UI --> APICLIENT --> ROUTES
    TPL --> UI
    ROUTES --> ENG
    ROUTES --> DISC --> PARSER
    ENG --> PARSER
    ENG --> RES
    ENG --> AI
    ENG --> DET
    DET --> HTTP --> LAB
    HTTP --> EXT
    DET --> EVID --> RED
    ENG --> SEV
    TYPES -.-> ENG
    TYPES -.-> ROUTES
    TYPES -.-> UI
    ENG -- events --> SSE -- stream --> APICLIENT
    ENG -- redacted results --> DB
    DB --> REP
    CLI --> ENG
    ROUTES --> DB
