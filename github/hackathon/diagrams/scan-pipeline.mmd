%% Shulker — Detailed Scan Pipeline (ScanEngine.run lifecycle)
flowchart TD
    START(["POST /api/scan or /api/demo"]) --> GATE{"validateTarget()<br/>loopback/private → allow<br/>public → require allowExternal<br/>AND confirmAuthorized"}
    GATE -- refused --> REFUSED["403 refusal — nothing leaves the server"]
    GATE -- allowed --> AUTHH["buildAuthHeaders()<br/>api-key / bearer / basic / custom<br/>(Host + Content-Length injection blocked)"]
    AUTHH --> ENG["ScanEngine.run() — budget armed (default 150 reqs, 5-min watchdog)"]

    ENG --> P1["PHASE 1 · PARSE<br/>parseSpecText() — OpenAPI 3 / Swagger 2 / Postman / HAR"]
    P1 -- invalid --> INV["INVALID_OPENAPI — scan halts cleanly"]
    P1 --> EP["ENDPOINTS_DISCOVERED (count + inventory)"]

    EP --> P2["PHASE 2 · AUTHENTICATE<br/>static credentials actor OR login-flow actors (Alice / Bob / admin)"]
    P2 --> P3["PHASE 3 · RESOURCES + HYPOTHESES<br/>resources.ts ownership model<br/>ai.ts Gemini ranking (advisory, optional)"]

    P3 --> P4["PHASE 4 · TESTING (detectors, budget-metered)"]
    P4 --> D1["bola.ts — replay Alice's objects with Bob's token<br/>200 = confirmed BOLA"]
    P4 --> D2["bfla.ts — privileged endpoints as low-priv actor<br/>success = CRITICAL · correct denial = PASS control"]
    P4 --> D3["exposure.ts — observed fields vs documented schema<br/>sensitive undocumented field = HIGH"]
    P4 --> D4["ratelimit.ts — capped polite burst on auth endpoints<br/>no 429 = MEDIUM potential"]

    cancel{"cancelled?"}
    D1 & D2 & D3 & D4 --> cancel
    cancel -- yes --> STOP["halt — persist partial results"]
    cancel -- no --> P5["PHASE 5 · ANALYSIS<br/>evidence.ts captures request/response<br/>→ shared/redact.ts BEFORE storage"]

    P5 --> P6["PHASE 6 · FINDINGS<br/>correlate tests ↔ findings · severity roll-up (shared/severity.ts)"]
    P6 --> P7["PHASE 7 · DONE<br/>ScanResult → sqlite (shulker.db)"]

    P7 --> OUT["SSE SCAN_DONE · UI navigates to Findings ·<br/>reports via /api/report/:id.html|.md|.json ·<br/>CLI maps worst severity to --fail-on exit code"]

    style REFUSED fill:#fef2f2,stroke:#dc2626
    style INV fill:#fef2f2,stroke:#dc2626
    style STOP fill:#fffbeb,stroke:#d97706
    style OUT fill:#f0fdf4,stroke:#16a34a
